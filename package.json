{
  "name": "ag-grid-url-sync",
  "version": "0.5.1",
  "description": "AG Grid URL Sync - Synchronize AG Grid text filters with URL parameters",
  "main": "dist/index.js",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.js"
    },
    "./validation": {
      "types": "./dist/core/validation.d.ts",
      "import": "./dist/core/validation.js",
      "require": "./dist/core/validation.js"
    },
    "./url-parser": {
      "types": "./dist/core/url-parser.d.ts",
      "import": "./dist/core/url-parser.js",
      "require": "./dist/core/url-parser.js"
    },
    "./url-generator": {
      "types": "./dist/core/url-generator.d.ts",
      "import": "./dist/core/url-generator.js",
      "require": "./dist/core/url-generator.js"
    },
    "./grid-integration": {
      "types": "./dist/core/grid-integration.d.ts",
      "import": "./dist/core/grid-integration.js",
      "require": "./dist/core/grid-integration.js"
    },
    "./view-storage": {
      "types": "./dist/core/view-storage.d.ts",
      "import": "./dist/core/view-storage.js",
      "require": "./dist/core/view-storage.js"
    },
    "./types": {
      "types": "./dist/core/types.d.ts",
      "import": "./dist/core/types.js",
      "require": "./dist/core/types.js"
    },
    "./serialization": {
      "types": "./dist/core/serialization/index.d.ts",
      "import": "./dist/core/serialization/index.js",
      "require": "./dist/core/serialization/index.js"
    },
    "./serialization/formats": {
      "types": "./dist/core/serialization/formats.d.ts",
      "import": "./dist/core/serialization/formats.js",
      "require": "./dist/core/serialization/formats.js"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "dist/index.d.ts"
      ],
      "react": [
        "dist/react/index.d.ts"
      ],
      "validation": [
        "dist/core/validation.d.ts"
      ],
      "url-parser": [
        "dist/core/url-parser.d.ts"
      ],
      "url-generator": [
        "dist/core/url-generator.d.ts"
      ],
      "grid-integration": [
        "dist/core/grid-integration.d.ts"
      ],
      "view-storage": [
        "dist/core/view-storage.d.ts"
      ],
      "types": [
        "dist/core/types.d.ts"
      ],
      "serialization": [
        "dist/core/serialization/index.d.ts"
      ],
      "serialization/formats": [
        "dist/core/serialization/formats.d.ts"
      ]
    }
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist",
    "compile": "tsc --removeComments && tsc --emitDeclarationOnly",
    "build": "npm run clean && npm run compile && npm run validate",
    "validate": "npm run size-check && npm run type-check",
    "size-check": "size-limit",
    "type-check": "tsc --noEmit --strict && tsc -p tsconfig.typecheck.json",
    "ci": "npm run build && npm run check-exports && npm run lint && npm run format:check && npm run test",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nearform/ag-grid-url-sync.git"
  },
  "keywords": [
    "ag-grid",
    "url",
    "state",
    "sync",
    "filter",
    "share",
    "typescript",
    "react"
  ],
  "author": "NearForm",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nearform/ag-grid-url-sync/issues"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/nearform/ag-grid-url-sync#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@oxlint/plugins": "1.90.0",
    "@size-limit/esbuild": "^14.0.0",
    "@size-limit/file": "^14.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "@vitest/coverage-v8": "^5.0.1",
    "ag-grid-community": "^36.1.0",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.75.0",
    "oxlint": "1.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.0.1",
    "size-limit": "^14.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  },
  "peerDependencies": {
    "ag-grid-community": ">=28.0.0",
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "size-limit": [
    {
      "name": "dist/index.js (bundled)",
      "path": "./dist/index.js",
      "limit": "11.9 KiB",
      "gzip": true
    },
    {
      "name": "dist/react/index.js (bundled, react external)",
      "path": "./dist/react/index.js",
      "limit": "14.5 KiB",
      "gzip": true,
      "ignore": [
        "react"
      ]
    },
    {
      "path": "./dist/core/ag-grid-url-sync.js",
      "limit": "4 KiB",
      "gzip": true,
      "disablePlugins": [
        "@size-limit/esbuild"
      ]
    },
    {
      "path": "./dist/core/validation.js",
      "limit": "2.5 KiB",
      "gzip": true,
      "disablePlugins": [
        "@size-limit/esbuild"
      ]
    },
    {
      "path": "./dist/core/url-parser.js",
      "limit": "3 KiB",
      "gzip": true,
      "disablePlugins": [
        "@size-limit/esbuild"
      ]
    },
    {
      "path": "./dist/core/url-generator.js",
      "limit": "2 KiB",
      "gzip": true,
      "disablePlugins": [
        "@size-limit/esbuild"
      ]
    },
    {
      "path": "./dist/core/individual-params.js",
      "limit": "3 KiB",
      "gzip": true,
      "disablePlugins": [
        "@size-limit/esbuild"
      ]
    },
    {
      "path": "./dist/core/grid-integration.js",
      "limit": "3 KiB",
      "gzip": true,
      "disablePlugins": [
        "@size-limit/esbuild"
      ]
    },
    {
      "path": "./dist/core/view-storage.js",
      "limit": "1.5 KiB",
      "gzip": true,
      "disablePlugins": [
        "@size-limit/esbuild"
      ]
    },
    {
      "path": "./dist/react/use-ag-grid-url-sync.js",
      "limit": "4.5 KiB",
      "gzip": true,
      "disablePlugins": [
        "@size-limit/esbuild"
      ]
    }
  ],
  "dependencies": {
    "use-sync-external-store": "^1.7.0",
    "valibot": "^1.5.0"
  }
}
