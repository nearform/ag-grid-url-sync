{
  "name": "ag-grid-url-sync",
  "version": "0.5.4",
  "description": "Sync AG Grid filters (text, number, date) with the URL: shareable links, browser history and saved views. Framework-free core and a React hook.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./views": {
      "types": "./dist/core/view-storage.d.ts",
      "import": "./dist/core/view-storage.js",
      "default": "./dist/core/view-storage.js"
    }
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist",
    "compile": "tsc --removeComments && tsc --emitDeclarationOnly",
    "build": "npm run clean && npm run compile && npm run validate",
    "validate": "npm run size-check && npm run type-check",
    "size-check": "size-limit",
    "type-check": "tsc --noEmit --strict && tsc -p tsconfig.typecheck.json",
    "ci": "npm run build && npm run check-exports && npm run lint && npm run format:check && npm run test",
    "check-exports": "attw --pack . --profile esm-only && node -e \"require('ag-grid-url-sync'); require('ag-grid-url-sync/react'); require('ag-grid-url-sync/views')\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nearform/ag-grid-url-sync.git"
  },
  "keywords": [
    "ag-grid",
    "url",
    "state",
    "sync",
    "filter",
    "share",
    "typescript",
    "react",
    "ag-grid-community",
    "filter-model",
    "url-state",
    "query-string",
    "deep-link",
    "saved-views",
    "react-hook"
  ],
  "author": "NearForm",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nearform/ag-grid-url-sync/issues"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/nearform/ag-grid-url-sync#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@oxlint/plugins": "1.92.0",
    "@size-limit/esbuild": "^14.0.0",
    "@size-limit/file": "^14.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "@vitest/coverage-v8": "^5.0.1",
    "ag-grid-community": "^36.1.0",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.77.0",
    "oxlint": "1.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.0.1",
    "size-limit": "^14.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  },
  "peerDependencies": {
    "ag-grid-community": ">=31.0.0",
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "size-limit": [
    {
      "name": "ag-grid-url-sync (bundled)",
      "path": "./dist/index.js",
      "limit": "14.5 KiB",
      "gzip": true
    },
    {
      "name": "createGridUrlSync only (tree-shaken)",
      "path": "./dist/index.js",
      "import": "{ createGridUrlSync }",
      "limit": "14.4 KiB",
      "gzip": true
    },
    {
      "name": "ag-grid-url-sync/react (bundled, react external)",
      "path": "./dist/react/index.js",
      "limit": "17.4 KiB",
      "gzip": true,
      "ignore": [
        "react"
      ]
    },
    {
      "name": "useGridUrlSync only (tree-shaken, react external)",
      "path": "./dist/react/index.js",
      "import": "{ useGridUrlSync }",
      "limit": "17.3 KiB",
      "gzip": true,
      "ignore": [
        "react"
      ]
    },
    {
      "name": "ag-grid-url-sync/views (bundled)",
      "path": "./dist/core/view-storage.js",
      "limit": "4.3 KiB",
      "gzip": true
    }
  ],
  "dependencies": {
    "use-sync-external-store": "^1.7.0",
    "valibot": "^1.5.0"
  }
}
